# Copy to .env.local for development. Nothing here is a real secret.

# --- LLM proxy -------------------------------------------------------------
# The Cloudflare worker in llm-worker/. Leave unset and set MOCK_LLM=true to
# run the whole agent loop offline against the scripted mock in
# app/api/chat/route.ts.
LLM_WORKER_URL=https://extract-excel-app-llm-worker.sumtsui.workers.dev
LLM_API_KEY=
MOCK_LLM=false

# --- Auth (better-auth + Google) -------------------------------------------
# AUTH_SECRET: any 32+ random chars, e.g. `openssl rand -base64 32`.
# AUTH_URL must match the origin the browser uses, and the Google OAuth client
# must list <AUTH_URL>/api/auth/callback/google as an authorized redirect URI.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Skips sign-in and treats every request as the user "dev-local". Ignored when
# NODE_ENV=production. Turn it OFF before testing anything tier- or credit-
# related, or every request looks like the same signed-in user.
BYPASS_AUTH=false
NEXT_PUBLIC_BYPASS_AUTH=false

# --- Fault injection -------------------------------------------------------
# Makes the FIRST AI run after each page load lose its last batch, so the
# partial-result dialog can be exercised without waiting for a real failure.
# Spent after that one run: retrying from the dialog succeeds. Reload to arm it
# again. Ignored when NODE_ENV=production.
NEXT_PUBLIC_MOCK_BATCH_FAILURE=0

# --- Debug trace -----------------------------------------------------------
# Records the whole agent chain — system prompt, flattened history, raw model
# reply, parsed tool call, tool result, and every row batch — to the browser
# console AND to .dev-trace/<day>.jsonl. Read it back with
# `node scripts/trace.mjs` (--list, --turn <id>, --last N). Ignored when
# NODE_ENV=production; the sink route 404s there.
NEXT_PUBLIC_DEBUG_TRACE=0

# --- Stripe ----------------------------------------------------------------
# Test keys during development. STRIPE_WEBHOOK_SECRET comes from
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids from the Stripe dashboard, one per credit pack (lib/billing/packs.ts).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
